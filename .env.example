# Secret callers must send as `Authorization: Bearer <it>`. Blank means anyone who can reach
# Iris can use it, which the demo page needs. Set one (`openssl rand -hex 32`) on a public URL.
IRIS_API_TOKEN=

# Secret for GET /v1/quality. Blank makes it 404. To use it, store the same value as the
# QUALITY_TOKEN repository secret.
IRIS_QUALITY_TOKEN=

# Number of proxies in front of Iris (1 behind one Caddy/nginx). Blank behind a proxy means
# every caller shares one rate-limit bucket.
IRIS_TRUST_PROXY=

# Model provider key (see docs/models.md).
OPENROUTER_API_KEY=

# Bedrock uses the standard AWS credential chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2
